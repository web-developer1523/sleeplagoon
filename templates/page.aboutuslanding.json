          "settings": {
            "fullWidth": true,
            "content": "OUR INSPIRATION",
            "textColor": "rgba(0,0,0,0)",
            "fontFamily": "base",
            "fontSize": "medium"
          }
        },
        "89d4d6f2-e01e-46ac-8389-710ef7bd24c1": {
          "type": "title",
          "settings": {
            "fullWidth": true,
            "content": "From the Founder",
            "textColor": "#003e52",
            "fontFamily": "title",
