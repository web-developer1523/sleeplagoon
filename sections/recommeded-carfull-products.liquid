{% comment %}
  Recommended Cartfull – Heading with placeholders filled from Cartful quiz.
  Logged-in: data from customer tags (quiz__*). Guest: data from localStorage cartful_complete_sessions.
  Same variable names for both; sources differ.
{% endcomment %}

{% if section.settings.enabled %}

{% assign sleep_position_value = '' %}
{% assign quiz_product_handle_by_name = '' %}
{% assign quiz_product_handle_by_id = '' %}
{% assign quiz_product_name_raw = '' %}
{% assign body_frame_value = '' %}
{% assign pillow_feel_value = '' %}
{% assign pillow_support_value = '' %}
{% assign sleep_challenge_value = '' %}
{% assign sleep_goal_value = '' %}
{% assign sleep_temperature_value = '' %}
{% if customer %}
  {% assign tag_list = customer.tags | split: ', ' %}
  {% for tag in tag_list %}
    {% assign tag_stripped = tag | strip %}
    {% if tag_stripped contains 'quiz__sleep_position__' %}
      {% assign sleep_position_value = tag_stripped | remove_first: 'quiz__sleep_position__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
    {% if tag_stripped contains 'quiz__product_name__' %}
      {% assign quiz_product_name_raw = tag_stripped | remove_first: 'quiz__product_name__' %}
      {% assign h = quiz_product_name_raw | replace: '_', '-' | downcase %}
      {% if h != '' %}{% assign quiz_product_handle_by_name = h %}{% endif %}
    {% endif %}
    {% if tag_stripped contains 'quiz__product_id__' %}
      {% assign h = tag_stripped | remove_first: 'quiz__product_id__' | downcase %}
      {% if h != '' %}{% assign quiz_product_handle_by_id = h %}{% endif %}
    {% endif %}
    {% if tag_stripped contains 'quiz__body_frame__' %}
      {% assign body_frame_value = tag_stripped | remove_first: 'quiz__body_frame__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
    {% if tag_stripped contains 'quiz__pillow_feel__' %}
      {% assign pillow_feel_value = tag_stripped | remove_first: 'quiz__pillow_feel__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
    {% if tag_stripped contains 'quiz__pillow_support__' %}
      {% assign pillow_support_value = tag_stripped | remove_first: 'quiz__pillow_support__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
    {% if tag_stripped contains 'quiz__sleep_challenge__' %}
      {% assign sleep_challenge_value = tag_stripped | remove_first: 'quiz__sleep_challenge__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
    {% if tag_stripped contains 'quiz__sleep_goal__' %}
      {% assign sleep_goal_value = tag_stripped | remove_first: 'quiz__sleep_goal__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
    {% if tag_stripped contains 'quiz__sleep_temperature__' %}
      {% assign sleep_temperature_value = tag_stripped | remove_first: 'quiz__sleep_temperature__' | replace: '_', ' ' | capitalize | replace: '"', '' %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign quiz_product_handle = '' %}
{% if quiz_product_handle_by_name != '' %}
  {% assign quiz_product_handle = quiz_product_handle_by_name %}
{% elsif quiz_product_handle_by_id != '' %}
  {% assign quiz_product_handle = quiz_product_handle_by_id %}
{% endif %}

{% if quiz_product_name_raw != '' %}
  {% assign recommended_name = quiz_product_name_raw | replace: '_', ' ' | capitalize | replace: '"', '' %}
{% else %}
  {% assign recommended_name = product.title | default: 'this' %}
{% endif %}

{% assign heading_text = section.settings.heading | default: "Here's why the [recommended] pillow is best for [side] sleepers." %}
{% assign heading_text = heading_text | replace: '[recommended]', recommended_name %}
{% assign heading_text = heading_text | replace: '[side]', sleep_position_value %}
{% assign heading_text = heading_text | replace: '[body_frame]', body_frame_value %}
{% assign heading_text = heading_text | replace: '[pillow_feel]', pillow_feel_value %}
{% assign heading_text = heading_text | replace: '[pillow_support]', pillow_support_value %}
{% assign heading_text = heading_text | replace: '[sleep_challenge]', sleep_challenge_value %}
{% assign heading_text = heading_text | replace: '[sleep_goal]', sleep_goal_value %}
{% assign heading_text = heading_text | replace: '[sleep_temperature]', sleep_temperature_value %}
<style>
.card__buttons a{
    background-color: #e3530f;
    color: #FFFFFF;
    width: 100%;
}
#s--{{ section.id }} .recommended-cartfull__heading {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
#s--{{ section.id }} .recommended-cartfull__heading .heading-tag {
  font-size: {{ section.settings.heading_size }};
}
{% if section.settings.heading_color != blank and section.settings.heading_color != 'rgba(0,0,0,0)' %}
#s--{{ section.id }} .recommended-cartfull__heading .heading-tag {
  color: {{ section.settings.heading_color }};
}
{% endif %}
#s--{{ section.id }} .recommended-cartfull__product {
  margin-top: 1.5rem;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
#s--{{ section.id }} .recommended-cartfull__card {
  max-width: 320px;
  width: 100%;
  margin: 0 auto;
}

</style>

<div class="recommended-cartfull recommended-cartfull--loading section__heading" id="s--{{ section.id }}"
  data-heading-raw="{{ section.settings.heading | escape }}"
  data-placeholder-recommended="{{ recommended_name | escape }}"
  data-placeholder-side="{{ sleep_position_value | escape }}"
  data-placeholder-body-frame="{{ body_frame_value | escape }}"
  data-placeholder-pillow-feel="{{ pillow_feel_value | escape }}"
  data-placeholder-pillow-support="{{ pillow_support_value | escape }}"
  data-placeholder-sleep-challenge="{{ sleep_challenge_value | escape }}"
  data-placeholder-sleep-goal="{{ sleep_goal_value | escape }}"
  data-placeholder-sleep-temperature="{{ sleep_temperature_value | escape }}"
  data-quiz-product-name="{{ quiz_product_name_raw | replace: '_', ' ' | capitalize | replace: '"', '' }}"
  data-quiz-product-handle="{{ quiz_product_handle | replace: '"', ''}}"
  data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}">
  <div class="recommended-cartfull__heading {{ section.settings.heading_alignment }}">
    {% assign subheading_clean = section.settings.subheading | strip %}
    {% if subheading_clean != blank and subheading_clean != '__HIDE__' %}
      <span class="section__heading--subheading recommended-cartfull__subheading">{{ subheading_clean }}</span>
    {% endif %}
    {% case section.settings.heading_tag %}
      {% when 'h1' %}<h1 class="heading-tag h-reset font__family--title">{{ heading_text }}</h1>
      {% when 'h2' %}<h2 class="heading-tag h-reset font__family--title">{{ heading_text }}</h2>
      {% when 'h3' %}<h3 class="heading-tag h-reset font__family--title">{{ heading_text }}</h3>
      {% else %}<h2 class="heading-tag h-reset font__family--title">{{ heading_text }}</h2>
    {% endcase %}
  </div>
  <div class="recommended-cartfull__product" id="recommended-cartfull-product--{{ section.id }}" aria-live="polite"></div>
</div>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var el = document.getElementById('s--' + sectionId);
  if (!el) return;
  var raw = el.getAttribute('data-heading-raw');
  var quizProductName = el.getAttribute('data-quiz-product-name') || '';
  var quizProductHandle = el.getAttribute('data-quiz-product-handle') || '';
  var isLoggedIn = el.getAttribute('data-customer-logged-in') === 'true';
  var headingEl = el.querySelector('.heading-tag');
  var productContainer = el.querySelector('.recommended-cartfull__product');

  /** Same variable names for admin; sources: logged-in = customer tags, guest = localStorage session */
  var placeholderKeys = ['recommended', 'side', 'body_frame', 'pillow_feel', 'pillow_support', 'sleep_challenge', 'sleep_goal', 'sleep_temperature'];

  function getPlaceholdersFromElement() {
    var m = {};
    placeholderKeys.forEach(function(key) {
      var attr = 'data-placeholder-' + key.replace(/_/g, '-');
      var val = el.getAttribute(attr) || '';
      m[key] = val;
    });
    if (quizProductName) m.recommended = quizProductName;
    if (!m.recommended) m.recommended = el.getAttribute('data-placeholder-recommended') || 'this';
    return m;
  }

  function formatPrefValue(str) {
    if (!str || typeof str !== 'string') return '';
    return str.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
  }

  function getPlaceholdersFromSession() {
    var placeholders = getPlaceholdersFromElement();
    var sessionData = localStorage.getItem('cartful_complete_sessions');
    if (!sessionData) return placeholders;
    try {
      var data = JSON.parse(sessionData);
      if (data && data.productName) placeholders.recommended = data.productName;
      var prefs = (data && data.shopperPreferences) || {};
      for (var q in prefs) {
        var qLower = q.toLowerCase();
        var val = formatPrefValue(prefs[q] || '');
        if (qLower.indexOf('sleep position') !== -1 || qLower.indexOf('go-to sleep position') !== -1) placeholders.side = val;
        else if (qLower.indexOf('sleep goal') !== -1 || qLower.indexOf('primary sleep goal') !== -1) placeholders.sleep_goal = val;
        else if (qLower.indexOf('sleep challenge') !== -1) placeholders.sleep_challenge = val;
        else if (qLower.indexOf('body frame') !== -1) placeholders.body_frame = val;
        else if (qLower.indexOf('sleep hot') !== -1 || qLower.indexOf('hot or cold') !== -1 || qLower.indexOf('temperature') !== -1) placeholders.sleep_temperature = val;
        else if (qLower.indexOf('pillow to feel') !== -1 || qLower.indexOf('pillow feel') !== -1) placeholders.pillow_feel = val;
        else if (qLower.indexOf('support') !== -1 && qLower.indexOf('head') !== -1) placeholders.pillow_support = val;
      }
    } catch (e) {}
    return placeholders;
  }

  function applyPlaceholders() {
    if (!headingEl || !raw) return;
    var placeholders = isLoggedIn ? getPlaceholdersFromElement() : getPlaceholdersFromSession();
    var text = raw;
    placeholderKeys.forEach(function(key) {
      var re = new RegExp('\\[' + key + '\\]', 'g');
      text = text.replace(re, placeholders[key] || '');
    });
    headingEl.textContent = text;
  }

  function productNameToHandle(name) {
    if (!name || typeof name !== 'string') return '';
    return name.toLowerCase()
      .replace(/_/g, ' ')
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '');
  }

  function renderCartfulProduct() {
    if (!productContainer) return;
    var productName = '';
    var handle = '';

    if (isLoggedIn) {
      productName = quizProductName;
      handle = quizProductHandle;
    } else {
      var sessionData = localStorage.getItem('cartful_complete_sessions');
      if (!sessionData) return;
      try {
        var data = JSON.parse(sessionData);
        productName = data.productName || (data.product && data.product.title) || '';
      } catch (e) {
        return;
      }
    }

    // Use product name (handle) only for both login and logout – no product id
    var nameHandle = productNameToHandle(productName);
    var candidates = [];
    if (nameHandle) candidates.push(nameHandle);
    if (handle && handle !== nameHandle) candidates.push(handle);
    // Remove empties and duplicates
    var seen = {};
    candidates = candidates.filter(function(h) {
      if (!h) return false;
      if (seen[h]) return false;
      seen[h] = true;
      return true;
    });

    if (!candidates.length) return;

    function tryNext(index) {
      if (index >= candidates.length) {
        return;
      }
      var h = candidates[index];
      var url = '/products/' + h + '.js';
      var fullUrl = (window.location.origin || '') + url;
      console.log('Cartful recommended product URL (full):', fullUrl);
      fetch(url)
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(json) {
          if (!json) {
            tryNext(index + 1);
            return;
          }
          var p = json.product || json;
          var img = p.featured_image || (p.images && p.images[0]);
          var imgUrl = '';
          if (img) {
            imgUrl = typeof img === 'string' ? img : (img.src || img.url || (img.preview_image && img.preview_image.src) || '');
          }
          if (imgUrl && imgUrl.indexOf('//') === 0) {
            imgUrl = 'https:' + imgUrl;
          }
          var variants = (p.variants && p.variants.length) ? p.variants : [];
          var v = variants[0] || {};
          for (var i = 0; i < variants.length; i++) {
            if (variants[i].available) {
              v = variants[i];
              break;
            }
          }
          var priceCents = v.price != null ? parseInt(v.price, 10) : 0;
          var compareCents = (v.compare_at_price != null) ? parseInt(v.compare_at_price, 10) : 0;
          var moneyFormat = (window.Shopify && window.Shopify.formatMoney) ? window.Shopify.formatMoney : function(c) { return '$' + (c / 100).toFixed(2); };
          var priceHtml = priceCents ? '<span class="card__price">' + moneyFormat(priceCents) + '</span>' : '';
          if (compareCents && compareCents > priceCents) {
            priceHtml = '<span class="card__price card__price--sale">' + moneyFormat(priceCents) + ' <span class="card__price--old">' + moneyFormat(compareCents) + '</span></span>';
          }
          var productUrl = (typeof p.url === 'string' && p.url) ? p.url : ('/products/' + (p.handle || h));
          var imgSrc = imgUrl ? ('<img src="' + imgUrl.replace(/"/g, '&quot;') + '" alt="' + (p.title || '').replace(/"/g, '&quot;') + '" loading="lazy" width="300" height="300">') : '';
          productContainer.innerHTML =
            '<div class="recommended-cartfull__card card--default card--holder">' +
              '<a class="card__img--container" href="' + productUrl.replace(/"/g, '&quot;') + '">' +
                '<div class="card__img--ratio"><div class="card__img">' + imgSrc + '</div></div>' +
              '</a>' +
              '<div class="card__info">' +
                '<a class="card__title" href="' + productUrl.replace(/"/g, '&quot;') + '">' + (p.title || '').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</a>' +
                priceHtml +
                '<div class="card__buttons"><a href="' + productUrl.replace(/"/g, '&quot;') + '" class="button button--primary">View product</a></div>' +
              '</div>' +
            '</div>';
          el.classList.remove('recommended-cartfull--loading');
          try { if (window.BoosterTheme && window.BoosterTheme.events) window.BoosterTheme.events.trigger('booster:content:update'); } catch (e) {}
        })
        .catch(function(err) {
          tryNext(index + 1);
        });
    }

    tryNext(0);
  }

  function init() {
    if (!isLoggedIn) {
      var rawSession = localStorage.getItem('cartful_complete_sessions');
      if (!rawSession) return;
      try {
        var d = JSON.parse(rawSession);
        var hasProduct =
          (d && d.productName) ||
          (d && d.product && (d.product.title || d.product.handle));
        var hasPrefs =
          d && d.shopperPreferences && Object.keys(d.shopperPreferences).length > 0;
        if (!hasProduct && !hasPrefs) return;
      } catch (e) {
        return;
      }
    }
    applyPlaceholders();
    renderCartfulProduct();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% endif %}

{% schema %}
{
  "name": "Recommended Cartfull",
  "settings": [
    {
      "type": "header",
      "content": "Enable/Disable"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable recommended products block",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Use these variables in your heading text. Same names for all customers; data comes from customer tags when logged in, and from the Cartful browser session when logged out."
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "__HIDE__",
      "info": "Optional. Replace this text with your subheading (or delete it) to show one."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Here's why the [recommended] pillow is best for [side] sleepers.",
    },
    {
      "type": "paragraph",
      "content": "[recommended] — Quiz recommended product name | [side] — Sleep position | [body_frame] — Body frame | [pillow_feel] — Pillow feel | [pillow_support] — Support/loft | [sleep_challenge] — Sleep challenge | [sleep_goal] — Sleep goal | [sleep_temperature] — Sleep temp"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading element",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "text-start", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-end", "label": "Right" }
      ],
      "default": "text-start"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "1rem", "label": "Small" },
        { "value": "1.25rem", "label": "Medium" },
        { "value": "1.5rem", "label": "Large" },
        { "value": "2rem", "label": "Extra large" }
      ],
      "default": "1.5rem"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "Recommended Cartfull"
    }
  ]
}
{% endschema %}
