{% if customer %}
  <ul style="display:none;">
    {% assign tag_list = customer.tags | split: ', ' %}
    {% assign sleep_position = '' %}
    {% assign sleep_goal = '' %}

    {% for tag in tag_list %}
      {% assign parts = tag | split: '__' %}
      {% if parts.size > 2 %}
        {% assign key = parts[1] %}
        {% assign value = parts[2] %}
        <li><strong>{{ key }}:</strong> {{ value | replace: '_', ' ' | capitalize }}</li>

        {% if key == 'sleep_position' %}
          {% assign sleep_position = value %}
        {% endif %}

        {% if key == 'sleep_goal' %}
          {% assign sleep_goal = value %}
        {% endif %}

      {% endif %}
    {% endfor %}
  </ul>

<div>
  <p>We noticed you Sleep Position is <strong>{{ sleep_position | replace: '_', ' ' | capitalize | remove:'"' }}</strong> and Sleep Goal <strong>{{ sleep_goal | replace: '_', ' ' | capitalize | remove:'"' }}</strong></p>
</div>


  {% comment %} {% if sleep_position != '' %}
    <p>Sleep Position: {{ sleep_position | replace: '_', ' ' | capitalize }}</p>
  {% endif %}

  {% if sleep_goal != '' %}
    <p>Sleep Goal: {{ sleep_goal | replace: '_', ' ' | capitalize }}</p>
  {% endif %}
{% endif %}  {% endcomment %}

{% else %}
<!-- Logged-out user: use JS to read localStorage -->
<ul id="customer-preferences" style="display:none;"></ul>
<p id="customer-preferences-text" style="text-align:center;"></p>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sessionData = localStorage.getItem('cartful_complete_sessions');
  if (!sessionData) return;

  try {
    const data = JSON.parse(sessionData);
    const prefs = data.shopperPreferences || {};
    const ul = document.getElementById('customer-preferences');
    let sleepPosition = '';
    let sleepGoal = '';

    for (const [question, answer] of Object.entries(prefs)) {
      // Map question to key names
      let key = '';
      if (question.toLowerCase().includes('sleep position')) key = 'sleep_position';
      else if (question.toLowerCase().includes('primary sleep goal')) key = 'sleep_goal';
      else if (question.toLowerCase().includes('body frame')) key = 'body_frame';
      else if (question.toLowerCase().includes('pillow to feel')) key = 'pillow_feel';
      else if (question.toLowerCase().includes('support under your head')) key = 'head_support';
      else if (question.toLowerCase().includes('sleep hot or cold')) key = 'sleep_temperature';
      else if (question.toLowerCase().includes('sleep challenges')) key = 'sleep_challenges';
      else key = question.replace(/\s+/g, '_').toLowerCase();

      // Create list item for other preferences
      if (key !== 'sleep_position' && key !== 'sleep_goal') {
        const li = document.createElement('li');
        li.innerHTML = `<strong>${key}:</strong> ${answer}`;
        ul.appendChild(li);
      }

      // Save sleep_position and sleep_goal
      if (key === 'sleep_position') sleepPosition = answer;
      if (key === 'sleep_goal') sleepGoal = answer;
    }

    // Display single message in the required format
    if (sleepPosition || sleepGoal) {
      const textEl = document.getElementById('customer-preferences-text');
      const formatText = (str) => {
        if (!str) return '';
        // Replace underscores with space and capitalize first letter of each word
        return str.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
      };
      textEl.innerHTML = `We noticed your Sleep Position is <strong>${formatText(sleepPosition)}</strong> and Sleep Goal <strong>${formatText(sleepGoal)}</strong>`;
    }

  } catch(e) {
    console.error('Error parsing session data:', e);
  }
});
</script>

{% endif %}





